<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required Nothing Glyph Matrix permission -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Required to keep animation running continuously even when screen is ON or OFF -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_toy_preview"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_toy_preview"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- SDK key metadata for Nothing Glyph Developer Kit compatibility -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            1. Official Nothing Glyph Toy Service (AOD Toy for Nothing Phone 4a Pro 13x13 Matrix)
            Appears in Settings -> Glyph Interface -> Flip to Glyph -> Always-on Glyph Toy
        -->
        <service
            android:name=".HamsterToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/ic_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />
        </service>

        <!--
            2. Screen-On & Charging Persistence Foreground Service
            Ensures the 13x13 hamster wheel animation NEVER stops when the screen turns on,
            and reacts instantaneously to power connect / disconnect with smooth deceleration.
        -->
        <service
            android:name=".HamsterForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous Glyph Matrix LED animation for charging and screen-on state on Nothing Phone (4a) Pro" />
        </service>

        <!-- Power & Boot Receiver -->
        <receiver
            android:name=".PowerStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
